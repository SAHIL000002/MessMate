# Copy this file to .env and fill in your own values.
# Never commit a real .env file: it holds the database password.
#
# The API reads the connection string from MONGO_URI. MONGODB_URI is accepted
# too (hosting panels often store it under that name) - see src/config/db.js.
# PORT and HOST must stay as below for deployment: the host provides PORT.

# Local development (MongoDB running on this computer)
PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/messmate

# Production (MongoDB Atlas). Use the SAME variable name in the hosting panel,
# replace <user>/<password>/<cluster>, allow the host in Atlas -> Network
# Access, and keep the real value out of git.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/MessMate?retryWrites=true&w=majority

