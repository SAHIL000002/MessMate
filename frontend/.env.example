# Optional. Copy this file to `.env` ONLY if the auto-detected LAN IP is wrong.
#
# When this is not set, src/services/api.js derives the API host from the
# Expo dev server host, which is normally the correct LAN IP for your phone.
#
# Replace with your computer's LAN IPv4 address (ipconfig -> IPv4 Address).
# Do not use localhost or 127.0.0.1 for a physical phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5000/api
